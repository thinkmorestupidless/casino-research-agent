# Path to the Google service-account JSON key used for Sheets + Drive API access.
# Never commit the actual key file or its contents.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# The target Google Sheets spreadsheet ID (the long ID segment in the sheet's URL).
SPREADSHEET_ID=

# Optional: root Drive folder ID under which the archive hierarchy is created.
# If unset, a "Casino Competitive Intelligence" folder is created at Drive root.
DRIVE_ROOT_FOLDER_ID=

# Optional: path to the local SQLite fingerprint/document-hash cache.
# Defaults to .cache/casino_intel.sqlite3 if unset.
CASINO_INTEL_CACHE_PATH=
